# Banco de dados (gerado automaticamente pelo Railway ao adicionar MySQL)
DATABASE_URL=mysql://user:password@host:3306/railway

# Segurança — coloque uma string longa e aleatória
JWT_SECRET=troque-por-uma-chave-secreta-longa

# Ambiente
NODE_ENV=production
PORT=3000

# Opcional — IA para resumos
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
